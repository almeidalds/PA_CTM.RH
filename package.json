{
  "name": "ctm-rh-powerapps",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && node scripts/validate-dist.cjs",
    "preview": "vite preview --host=0.0.0.0",
    "typecheck": "tsc --noEmit",
    "powerapps:init": "pa app init --display-name \"CTM - RH\" --build-path ./dist --file-entry-point index.html --app-url http://localhost:3000",
    "powerapps:run": "pa app run --local-app-url http://localhost:3000",
    "powerapps:push": "npm run typecheck && npm run build && pa app push",
    "doctor": "node scripts/check-env.cjs",
    "repair": "powershell -ExecutionPolicy Bypass -File ./scripts/REPARAR-PROJETO.ps1",
    "prepare:powerapps": "npm run doctor && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@microsoft/power-apps": "^1.6.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "read-excel-file": "^9.3.14",
    "recharts": "^3.9.1"
  },
  "devDependencies": {
    "@microsoft/power-apps-cli": "1.4.1",
    "@microsoft/power-apps-vite": "^1.0.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^6.2.3"
  },
  "description": "Painel de RH do CTM Brasil preparado para Power Apps Code Apps"
}
